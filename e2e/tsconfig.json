{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noEmit": true
	},
	"include": [
		"playwright.config.ts",
		"playwright.extended.config.ts",
		"timeouts.ts",
		"playwright.hiraya.config.ts",
		"playwright.motion.config.ts",
		"tests/**/*.ts",
		"motion/**/*.ts"
	]
}
