{
	"name": "@rondo/e2e",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"e2e": "playwright test --grep-invert \"@result|@hiraya|@layout\"",
		"e2e:layout": "playwright test --grep @layout",
		"e2e:result": "playwright test --grep @result",
		"e2e:hiraya": "playwright test --config playwright.hiraya.config.ts",
		"type-check": "tsc --noEmit",
		"e2e:extended": "playwright test --config playwright.extended.config.ts",
		"e2e:motion": "playwright test --config playwright.motion.config.ts",
		"e2e:expiry": "playwright test --config playwright.expiry.config.ts",
		"e2e:spectate": "playwright test --config playwright.spectate.config.ts"
	},
	"dependencies": {
		"@rondo/bots": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "20.17.6",
		"typescript": "^5.9.3"
	}
}
