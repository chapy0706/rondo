{
	"name": "@rondo/e2e",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"e2e": "playwright test --grep-invert \"@result|@hiraya\"",
		"e2e:result": "playwright test --grep @result",
		"e2e:hiraya": "playwright test --config playwright.hiraya.config.ts",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@rondo/bots": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "20.17.6",
		"typescript": "^5.9.3"
	}
}
